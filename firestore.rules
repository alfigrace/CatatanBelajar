rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: hanya pemilik akun yang boleh membaca dan menulis dokumennya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Catatan: hanya pemilik (field uid) yang boleh membaca, mengubah, dan menghapus
    match /notes/{noteId} {
      // Membuat: uid di dokumen harus sama dengan user yang login
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // Membaca (termasuk query whereEqualTo("uid", ...)), mengubah, menghapus
      allow read, delete: if request.auth != null
                          && resource.data.uid == request.auth.uid;

      // Mengubah: pemilik tidak boleh dipindahkan ke user lain
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
    }
  }
}
