<?xml version="1.0" encoding="utf-8"?>
<!-- Logo beranimasi untuk splash screen -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_logo_anim_base">

    <target
        android:name="phone"
        android:animation="@animator/draw_phone" />
    <target
        android:name="notch"
        android:animation="@animator/fade_notch" />
    <target
        android:name="chevron"
        android:animation="@animator/draw_chevron" />
    <target
        android:name="cursor"
        android:animation="@animator/blink_cursor" />
</animated-vector>
